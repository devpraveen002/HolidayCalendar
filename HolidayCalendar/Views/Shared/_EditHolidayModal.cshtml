<div class="modal fade" id="editHolidayModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Event</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="EditHoliday" method="post">
                <div class="modal-body">
                    <input type="hidden" name="Id" id="editHolidayId" />
                    <input type="hidden" name="CalendarId" value="@ViewBag.CalendarId" />
                    <div class="mb-3">
                        <label class="form-label">Event Name</label>
                        <input type="text" name="Name" id="editHolidayName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Date</label>
                        <input type="date" name="Date" id="editHolidayDate" class="form-control" required />
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" name="IsFixedHoliday" id="editIsFixed" class="form-check-input" />
                        <label class="form-check-label" for="editIsFixed">Fixed Event</label>
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" name="IsWeekendAdjustable" id="editIsAdjustable" class="form-check-input" />
                        <label class="form-check-label" for="editIsAdjustable">Weekend Adjustable</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>