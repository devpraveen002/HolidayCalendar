@model EditHolidayViewModel

<div class="modal">
    <!-- Modal content for editing holiday -->
    <form asp-action="EditHoliday" method="post">
        <input type="hidden" asp-for="HolidayId" />
        <input type="hidden" asp-for="CalendarId" />
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <label asp-for="Date"></label>
        <input asp-for="Date" class="form-control" type="date" />
        <label asp-for="IsFixedHoliday"></label>
        <input asp-for="IsFixedHoliday" type="checkbox" />
        <label asp-for="IsWeekendAdjustable"></label>
        <input asp-for="IsWeekendAdjustable" type="checkbox" />
        <button type="submit" class="btn btn-primary">Save</button>
    </form>
</div>
