@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Holiday Calendar Version1.5</h1>

    @if (!User.Identity.IsAuthenticated)
    {
        <p>
            <a asp-controller="Account" asp-action="Login">Login here</a> to create/edit/share calendar
        </p>
    }

    <a asp-controller="Calendar" asp-action="Index" class="btn btn-primary">
        Go to Calendar
    </a>
</div>

