@model CreateCountryViewModel

<div class="container py-5">
    <h1>Add New Country</h1>

    <form asp-action="CreateCountry" method="post">
        <div class="mb-3">
            <label asp-for="SelectedCountryCode" class="form-label">Select Country</label>
            <select asp-for="SelectedCountryCode" asp-items="Model.AvailableCountries" class="form-select"></select>
            <span asp-validation-for="SelectedCountryCode" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="AdminDashboard" class="btn btn-secondary">Cancel</a>
    </form>
</div>
