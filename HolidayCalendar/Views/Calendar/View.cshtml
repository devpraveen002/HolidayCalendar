@model CalendarViewModel

<div class="container py-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-center">@Model.Calendar.Name</h1>
        <a asp-action="@((User.IsInRole("Admin")) ? "AdminDashboard" : "Dashboard")" class="btn btn-secondary">
            <i class="fa fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    <!-- Calendar Selection -->
    @* <form asp-action="View" method="get">
        <select name="id" asp-items="Model.AvailableCalendars" class="form-select">
            <option value="" disabled selected>Select Calendar</option>
            @foreach (var calendar in Model.AvailableCalendars)
            {
                <option value="@calendar.Value" selected="@(calendar.Value == Model.Calendar.Id.ToString())">@calendar.Text</option>
            }
        </select>
        <button type="submit" class="btn btn-secondary">Switch</button>
    </form> *@


    <!-- Month/Year Navigation -->
    <div class="row mb-4">
        <div class="col-md-6">
            <form asp-action="View" method="get" class="d-flex gap-2">
                <input type="hidden" name="id" value="@Model.Calendar.Id" />
                <select name="month" class="form-select w-auto">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i" selected="@(i == Model.CurrentMonth)">@System.Globalization.DateTimeFormatInfo.CurrentInfo.GetMonthName(i)</option>
                    }
                </select>
                <select name="year" class="form-select w-auto">
                    @for (int year = Model.CurrentYear - 5; year <= Model.CurrentYear + 5; year++)
                    {
                        <option value="@year" selected="@(year == Model.CurrentYear)">@year</option>
                    }
                </select>
                <button type="submit" class="btn btn-primary">Go</button>
            </form>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="View" asp-route-id="@Model.Calendar.Id"
               asp-route-month="@((Model.CurrentMonth == 1) ? 12 : Model.CurrentMonth - 1)"
               asp-route-year="@((Model.CurrentMonth == 1) ? Model.CurrentYear - 1 : Model.CurrentYear)"
               class="btn btn-outline-primary">Previous</a>
            <a asp-action="View" asp-route-id="@Model.Calendar.Id"
               asp-route-month="@((Model.CurrentMonth == 12) ? 1 : Model.CurrentMonth + 1)"
               asp-route-year="@((Model.CurrentMonth == 12) ? Model.CurrentYear + 1 : Model.CurrentYear)"
               class="btn btn-outline-primary">Next</a>
        </div>
    </div>

    <!-- Calendar Rendering -->
    <div class="calendar-container">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Sun</th>
                    <th>Mon</th>
                    <th>Tue</th>
                    <th>Wed</th>
                    <th>Thu</th>
                    <th>Fri</th>
                    <th>Sat</th>
                </tr>
            </thead>
            <tbody>
                @for (var week = 0; week < 6; week++)
                {
                    <tr>
                        @for (var day = 0; day < 7; day++)
                        {
                            var currentDay = week * 7 + day - (int)new DateTime(Model.CurrentYear, Model.CurrentMonth, 1).DayOfWeek + 1;
                            var date = new DateTime(Model.CurrentYear, Model.CurrentMonth, 1).AddDays(currentDay - 1);

                            if (currentDay < 1 || currentDay > DateTime.DaysInMonth(Model.CurrentYear, Model.CurrentMonth))
                            {
                                <td class="bg-light"></td>
                            }
                            else
                            {
                                var holidays = Model.Holidays.Where(h => h.Date.Date == date.Date).ToList();
                                var events = Model.Events.Where(e => e.StartDate.Date == date.Date).ToList();
                                <td>
                                    <div class="day-container">
                                        <strong>@date.Day</strong>
                                        <!-- Holiday/Event List -->
                                        <ul>
                                            @foreach (var holiday in holidays)
                                            {
                                                <li>@holiday.Name</li>
                                            }
                                            @foreach (var evt in events)
                                            {
                                                <li>@evt.Name</li>
                                            }
                                        </ul>
                                        <!-- Hover Actions -->
                                        <div class="hover-actions">
                                            <form asp-action="AddEvent" method="post" class="d-inline">
                                                <input type="hidden" name="CalendarId" value="@Model.Calendar.Id" />
                                                <input type="hidden" name="Date" value="@date" />
                                                <button type="submit" class="btn btn-success btn-sm">
                                                    <i class="fa fa-plus"></i>
                                                </button>
                                            </form>
                                            <form asp-action="EditEvent" method="post" class="d-inline ms-2">
                                                <input type="hidden" name="CalendarId" value="@Model.Calendar.Id" />
                                                <input type="hidden" name="Date" value="@date" />
                                                <button type="submit" class="btn btn-warning btn-sm">
                                                    <i class="fa fa-edit"></i>
                                                </button>
                                            </form>
                                            <form asp-action="DeleteEvent" method="post" class="d-inline ms-2">
                                                <input type="hidden" name="CalendarId" value="@Model.Calendar.Id" />
                                                <input type="hidden" name="Date" value="@date" />
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Export Options -->
    <div class="d-flex justify-content-between align-items-center mt-4">
        <!-- Export Current Month -->
        <div>
            <h5>Export Current Month</h5>
            <a asp-action="ExportToExcel" asp-route-calendarId="@Model.Calendar.Id" asp-route-date="@(new DateTime(Model.CurrentYear, Model.CurrentMonth, 1))" class="btn btn-outline-success">Excel</a>
            <a asp-action="ExportToPdf" asp-route-calendarId="@Model.Calendar.Id" asp-route-date="@(new DateTime(Model.CurrentYear, Model.CurrentMonth, 1))" class="btn btn-outline-danger">PDF</a>
            <a asp-action="ExportToCsv" asp-route-calendarId="@Model.Calendar.Id" asp-route-date="@(new DateTime(Model.CurrentYear, Model.CurrentMonth, 1))" class="btn btn-outline-primary">CSV</a>
            <a asp-action="ExportToIcs" asp-route-calendarId="@Model.Calendar.Id" asp-route-date="@(new DateTime(Model.CurrentYear, Model.CurrentMonth, 1))" class="btn btn-outline-secondary">ICS</a>
        </div>

        <!-- Export Year -->
        <div>
            <h5>Export Year</h5>
            <form asp-action="ExportYear" method="get">
                <div class="d-flex gap-2">
                    <select name="SelectedCountry" class="form-select w-auto">
                        @foreach (var country in Model.AvailableCountries)
                        {
                            <option value="@country.Value" selected="@(country.Value == Model.SelectedCountry)">@country.Text</option>
                        }
                    </select>
                    <select name="year" class="form-select w-auto">
                        @for (int year = DateTime.Now.Year - 5; year <= DateTime.Now.Year + 5; year++)
                        {
                            <option value="@year" selected="@(year == Model.CurrentYear)">@year</option>
                        }
                    </select>
                    <button type="submit" name="format" value="excel" class="btn btn-outline-success">Excel</button>
                    <button type="submit" name="format" value="pdf" class="btn btn-outline-danger">PDF</button>
                    <button type="submit" name="format" value="csv" class="btn btn-outline-primary">CSV</button>
                    <button type="submit" name="format" value="ics" class="btn btn-outline-secondary">ICS</button>
                </div>
            </form>
        </div>
    </div>
</div>
