@model CreateCalendarViewModel

<div class="container py-5">
    <h1>Create Default Calendar</h1>

    <form asp-action="CreateCountryCalendar" method="post">
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Calendar Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CountryCode" class="form-label">Country</label>
            <select asp-for="CountryCode" asp-items="Model.AvailableCountries" class="form-select"></select>
            <span asp-validation-for="CountryCode" class="text-danger"></span>
        </div>

        <div class="form-check">
            <input asp-for="IsDefault" class="form-check-input" type="checkbox" />
            <label asp-for="IsDefault" class="form-check-label">Set as Default Calendar</label>
        </div>

        <button type="submit" class="btn btn-primary mt-3">Create</button>
        <a asp-action="AdminDashboard" class="btn btn-secondary mt-3">Cancel</a>
    </form>
</div>
