@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col">
            <h2>My Calendars</h2>
        </div>
        <div class="col text-end">
            <a asp-action="Create" class="btn btn-primary">Create New Calendar</a>
        </div>
    </div>

    @if (!Model.Calendars.Any())
    {
        <div class="alert alert-info">
            <p>You don't have any calendars yet. Create one to get started!</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var calendar in Model.Calendars)
            {
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@calendar.Name</h5>
                            <p class="card-text">
                                <small class="text-muted">
                                    @calendar.Holidays.Count holidays
                                </small>
                            </p>
                            @if (calendar.IsDefault)
                            {
                                <span class="badge bg-primary mb-2">Default Calendar</span>
                            }
                        </div>
                        <div class="card-footer bg-transparent border-top-0">
                            <div class="d-flex justify-content-between">
                                <a asp-action="View" asp-route-id="@calendar.Id" class="btn btn-outline-primary btn-sm">View</a>
                                <a asp-action="Edit" asp-route-id="@calendar.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
                                <button type="button" class="btn btn-outline-info btn-sm" data-bs-toggle="modal" data-bs-target="#shareModal-@calendar.Id">
                                    <i class="fas fa-share-alt"></i>
                                </button>

                                @if (!calendar.IsDefault)
                                {
                                    <form asp-action="Delete" asp-route-id="@calendar.Id" method="post" style="display: inline;">
                                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure?')">
                                            Delete
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal fade" id="shareModal-@calendar.Id" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Share "@calendar.Name"</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                @if (!string.IsNullOrEmpty(calendar.ShareableLink))
                                {
                                    <div class="input-group">
                                        <input type="text" class="form-control" value="@($"{Context.Request.Scheme}://{Context.Request.Host}/Calendar/Share?shareableLink={calendar.ShareableLink}")" readonly>
                                        <a href="@($"{Context.Request.Scheme}://{Context.Request.Host}/Calendar/Share?shareableLink={calendar.ShareableLink}")"
                                           class="btn btn-outline-primary" target="_blank">
                                            <i class="fas fa-external-link-alt"></i> Open
                                        </a>
                                    </div>
                                    <small class="text-muted mt-2 d-block">Click the link to open in a new tab, then copy from your browser's address bar</small>
                                }
                                else
                                {
                                    <form asp-action="GenerateShareableLink" method="post">
                                        <input type="hidden" name="calendarId" value="@calendar.Id" />
                                        <button type="submit" class="btn btn-primary">Generate Shareable Link</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>