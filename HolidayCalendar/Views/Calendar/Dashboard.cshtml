@model DashboardViewModel
@using System.Security.Claims

<div class="container py-5">
    <h1>@(User.IsInRole("Admin") ? "Admin Dashboard" : "My Calendars")</h1>

    @if (User.IsInRole("Admin"))
    {
        <div class="d-flex justify-content-end mb-4">
            <a asp-action="CreateCountryCalendar" class="btn btn-primary">Create Country Calendar</a>
            <a asp-action="Create" class="btn btn-secondary ms-2">Create New Calendar</a>
        </div>
    }

    <table class="table table-bordered table-striped mt-4">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Country</th>
                <th>Holidays</th>
                <th>Default</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var calendar in Model.Calendars)
            {
                <tr>
                    <td>@calendar.Name</td>
                    <td>@calendar.CountryCode</td>
                    <td>@calendar.HolidayCount</td>
                    <td>@(calendar.IsDefault ? "Yes" : "No")</td>
                    <td>
                        <!-- View Button -->
                        <a asp-action="Index" asp-route-id="@calendar.Id" class="btn btn-primary btn-sm">View</a>

                        <!-- Edit Button -->
                        <a asp-action="Edit" asp-route-id="@calendar.Id" class="btn btn-warning btn-sm mx-1">Edit</a>

                        <!-- Delete Button -->
                        @if (User.IsInRole("Admin") || calendar.CreatedBy.ToString() == User.FindFirstValue(ClaimTypes.NameIdentifier))
                        {
                            <a asp-action="Delete" asp-route-id="@calendar.Id" class="btn btn-danger btn-sm">Delete</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
