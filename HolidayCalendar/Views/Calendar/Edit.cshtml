@model EditCalendarViewModel
@{
    ViewData["Title"] = "Edit Calendar";
    var isAdmin = User.IsInRole("Admin");
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h2 class="card-title">Edit Calendar</h2>
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="CalendarId" />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Calendar Name</label>
                            <input asp-for="Name" class="form-control" required />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        @if (isAdmin)
                        {
                            <div class="mb-3">
                                <label asp-for="SelectedCountry" class="form-label">Country</label>
                                <select asp-for="SelectedCountry" class="form-select" asp-items="Model.AvailableCountries"></select>
                                <span asp-validation-for="SelectedCountry" class="text-danger"></span>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="SelectedCountry" />
                        }

                        <div class="d-flex justify-content-between">
                            <a asp-action="Dashboard" class="btn btn-secondary">Back</a>
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
