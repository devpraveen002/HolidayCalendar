@model CalendarViewModel
@{
    ViewData["Title"] = "Calendar";
    var currentDate = DateTime.Now;
    var currentMonth = Model?.CurrentMonth ?? currentDate.Month;
    var currentYear = Model?.CurrentYear ?? currentDate.Year;
}

<div class="container-fluid py-3">
    <div class="row mb-4">
        <div class="col-12 text-end">
            <a asp-controller="Calendar" asp-action="Create" class="btn btn-success">
                Create New Calendar
            </a>
        </div>
    </div>
    <!-- Calendar Navigation -->
    <div class="row mb-4">
        <div class="col-md-6">
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <select name="month" class="form-select w-auto">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i" selected="@(i == currentMonth)">
                            @(new DateTime(2024, i, 1).ToString("MMMM"))
                        </option>
                    }
                </select>
                <select name="year" class="form-select w-auto">
                    @for (int year = currentYear - 5; year <= currentYear + 5; year++)
                    {
                        <option value="@year" selected="@(year == currentYear)">@year</option>
                    }
                </select>
                <button type="submit" class="btn btn-primary">Go</button>
            </form>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="Index" asp-route-month="@Model?.PreviousMonth" asp-route-year="@Model?.PreviousYear"
               class="btn btn-outline-primary">Previous</a>
            <a asp-action="Index" asp-route-month="@Model?.NextMonth" asp-route-year="@Model?.NextYear"
               class="btn btn-outline-primary">Next</a>
        </div>
    </div>

    <!-- Calendar Grid -->
    <div class="card">
        <div class="card-body p-2">
            <!-- Calendar Headers -->
            <div class="row g-0 text-center fw-bold border-bottom pb-2 mb-2">
                <div class="col border-end p-2">Sun</div>
                <div class="col border-end p-2">Mon</div>
                <div class="col border-end p-2">Tue</div>
                <div class="col border-end p-2">Wed</div>
                <div class="col border-end p-2">Thu</div>
                <div class="col border-end p-2">Fri</div>
                <div class="col p-2">Sat</div>
            </div>

            <!-- Calendar Dates -->
            @{
                var firstDay = new DateTime(currentYear, currentMonth, 1);
                var startingDayOfWeek = (int)firstDay.DayOfWeek;
                var daysInMonth = DateTime.DaysInMonth(currentYear, currentMonth);
                var currentWeek = new List<DateTime?>();
            }

            @for (int i = 0; i < 42; i++)
            {
                var dayNumber = i - startingDayOfWeek + 1;
                var date = dayNumber > 0 && dayNumber <= daysInMonth
                ? new DateTime(currentYear, currentMonth, dayNumber)
                : (DateTime?)null;

                currentWeek.Add(date);

                @if ((i + 1) % 7 == 0)
                {
                    <div class="row g-0 border-bottom" style="min-height: 120px;">
                        @foreach (var weekDate in currentWeek)
                        {
                            var holiday = weekDate.HasValue && Model?.Calendar?.Holidays != null
                            ? Model.Calendar.Holidays.FirstOrDefault(h => h.Date.Date == weekDate.Value.Date)
                            : null;

                            <div class="col border-end position-relative p-2 @(weekDate.HasValue ? "" : "bg-light")">
                                @if (weekDate.HasValue)
                                {
                                    <div class="fw-bold mb-1">@weekDate.Value.Day</div>
                                    @if (holiday != null)
                                    {
                                        <div class="bg-primary text-white rounded p-2 mb-1">
                                            <div class="small fw-bold">@holiday.Name</div>
                                        </div>
                                    }
                                    @if (Model?.IsEditable == true)
                                    {
                                        <a asp-action="AddHoliday"
                                           asp-route-date="@weekDate.Value.ToString("yyyy-MM-dd")"
                                           class="position-absolute top-0 end-0 m-1 btn btn-sm btn-primary rounded-circle"
                                           style="width: 24px; height: 24px; padding: 0; line-height: 24px;">+</a>
                                    }
                                }
                            </div>
                        }
                    </div>
                    currentWeek.Clear();
                }
            }
        </div>
    </div>

    <!-- Calendar Footer -->
    <div class="row mt-4">
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center gap-3">
                        <div class="d-flex align-items-center gap-2">
                            <span>Export Current Month:</span>
                            <form method="get" class="d-flex align-items-center gap-2">
                                <input type="hidden" name="date" value="@(new DateTime(currentYear, currentMonth, 1).ToString("yyyy-MM-dd"))" />

                                <button type="submit" formaction="@Url.Action("ExportToExcel")" class="btn btn-outline-success">
                                    <i class="fas fa-file-excel"></i> Excel
                                </button>

                                <button type="submit" formaction="@Url.Action("ExportToPdf")" class="btn btn-outline-danger">
                                    <i class="fas fa-file-pdf"></i> PDF
                                </button>

                                <button type="submit" formaction="@Url.Action("ExportToCsv")" class="btn btn-outline-info">
                                    <i class="fas fa-file-csv"></i> CSV
                                </button>

                                <button type="submit" formaction="@Url.Action("ExportToIcs")" class="btn btn-outline-warning">
                                    <i class="fas fa-calendar"></i> ICS
                                </button>
                            </form>
                        </div>
                        <div class="vr"></div>
                        <div class="d-flex align-items-center gap-2">
                            <span>Export Year:</span>
                            <form method="get" class="d-flex align-items-center gap-2">
                                <select name="year" class="form-select" style="width: 120px">
                                    @for (int year = currentYear - 5; year <= currentYear + 5; year++)
                                    {
                                        <option value="@year">@year</option>
                                    }
                                </select>
                                <button type="submit" formaction="@Url.Action("ExportYearToExcel")" class="btn btn-outline-success">
                                    <i class="fas fa-file-excel"></i> Excel
                                </button>
                                <button type="submit" formaction="@Url.Action("ExportYearToPdf")" class="btn btn-outline-danger">
                                    <i class="fas fa-file-pdf"></i> PDF
                                </button>
                                <button type="submit" formaction="@Url.Action("ExportYearToCsv")" class="btn btn-outline-info">
                                    <i class="fas fa-file-csv"></i> CSV
                                </button>
                                <button type="submit" formaction="@Url.Action("ExportYearToIcs")" class="btn btn-outline-warning">
                                    <i class="fas fa-calendar"></i> ICS
                                </button>
                            </form>
                        </div>
                        @if (Model?.IsEditable == true)
                        {
                            <div class="vr"></div>
                            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#shareModal">
                                Share Calendar
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model?.IsEditable == true)
{
    <div class="modal fade" id="shareModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Share Calendar</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(Model.ShareableLink))
                    {
                        <div class="input-group">
                            <input type="text" class="form-control" value="@Model.ShareableLink" readonly />
                            <button class="btn btn-outline-secondary">Copy</button>
                        </div>
                    }
                    else
                    {
                        <form asp-action="Share" method="post">
                            <input type="hidden" name="calendarId" value="@Model.Calendar?.Id" />
                            <button type="submit" class="btn btn-primary">Generate Shareable Link</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
}