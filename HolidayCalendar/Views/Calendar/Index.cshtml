@model CalendarViewModel

<div class="container py-5">
    <!-- Calendar Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-center">@Model.Calendar.Name</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa fa-plus"></i> Create New Calendar
        </a>
    </div>

    <!-- Country Selection -->
    <form asp-action="Index" method="get" class="d-flex mb-4">
        <label for="countryDropdown" class="me-2 align-self-center">Switch Country:</label>
        <select id="countryDropdown" asp-for="SelectedCountry" asp-items="Model.AvailableCountries" class="form-select me-2 w-auto"></select>
        <button type="submit" class="btn btn-secondary">
            <i class="fa fa-globe"></i> Go
        </button>
    </form>

    <!-- Month/Year Navigation -->
    <div class="row mb-4">
        <div class="col-md-6">
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <input type="hidden" name="SelectedCountry" value="@Model.SelectedCountry" />
                <select name="month" class="form-select w-auto">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i" selected="@(i == Model.CurrentMonth)">@DateTime.Now.AddMonths(i - DateTime.Now.Month).ToString("MMMM")</option>
                    }
                </select>
                <select name="year" class="form-select w-auto">
                    @for (int year = DateTime.Now.Year - 5; year <= DateTime.Now.Year + 5; year++)
                    {
                        <option value="@year" selected="@(year == Model.CurrentYear)">@year</option>
                    }
                </select>
                <button type="submit" class="btn btn-primary">Go</button>
            </form>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="Index" asp-route-SelectedCountry="@Model.SelectedCountry"
               asp-route-month="@Model.PreviousMonth" asp-route-year="@Model.PreviousYear"
               class="btn btn-outline-primary">Previous</a>
            <a asp-action="Index" asp-route-SelectedCountry="@Model.SelectedCountry"
               asp-route-month="@Model.NextMonth" asp-route-year="@Model.NextYear"
               class="btn btn-outline-primary">Next</a>
        </div>
    </div>

    <!-- Calendar -->
    <div class="calendar-container">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Sun</th>
                    <th>Mon</th>
                    <th>Tue</th>
                    <th>Wed</th>
                    <th>Thu</th>
                    <th>Fri</th>
                    <th>Sat</th>
                </tr>
            </thead>
            <tbody>
                @for (var week = 0; week < 6; week++)
                {
                    <tr>
                        @for (var day = 0; day < 7; day++)
                        {
                            var currentDay = week * 7 + day - (int)new DateTime(Model.CurrentYear, Model.CurrentMonth, 1).DayOfWeek + 1;
                            var date = new DateTime(Model.CurrentYear, Model.CurrentMonth, 1).AddDays(currentDay - 1);

                            if (currentDay < 1 || currentDay > DateTime.DaysInMonth(Model.CurrentYear, Model.CurrentMonth))
                            {
                                <td class="bg-light"></td>
                            }
                            else
                            {
                                var holidays = Model.Holidays.Where(h => h.Date.Date == date.Date).ToList();
                                <td>
                                    <strong>@date.Day</strong>
                                    @if (holidays.Any())
                                    {
                                        <ul>
                                            @foreach (var holiday in holidays)
                                            {
                                                <li>@holiday.Name</li>
                                            }
                                        </ul>
                                    }
                                    @if (Model.IsEditable)
                                    {
                                        <div class="admin-tools">
                                            <a asp-action="AddHolidayEvent" asp-route-calendarId="@Model.Calendar.Id" asp-route-date="@date" class="text-success">
                                                <i class="fa fa-plus"></i>
                                            </a>
                                            <a asp-action="EditHolidayEvent" asp-route-calendarId="@Model.Calendar.Id" asp-route-date="@date" class="text-warning ms-2">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            <a asp-action="DeleteHolidayEvent" asp-route-calendarId="@Model.Calendar.Id" asp-route-date="@date" class="text-danger ms-2">
                                                <i class="fa fa-trash"></i>
                                            </a>
                                        </div>
                                    }
                                </td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Export Options -->
    <div class="d-flex justify-content-between align-items-center mt-4">
        <!-- Export Current Month -->
        <div class="export-buttons">
            <h5>Export Current Month</h5>
            <a asp-action="ExportToExcel" asp-route-calendarId="@Model.Calendar.Id" asp-route-date="@(new DateTime(Model.CurrentYear, Model.CurrentMonth, 1))" class="btn btn-outline-success">
                <i class="fa fa-file-excel"></i> Excel
            </a>
            <a asp-action="ExportToPdf" asp-route-calendarId="@Model.Calendar.Id" asp-route-date="@(new DateTime(Model.CurrentYear, Model.CurrentMonth, 1))" class="btn btn-outline-danger">
                <i class="fa fa-file-pdf"></i> PDF
            </a>
            <a asp-action="ExportToCsv" asp-route-calendarId="@Model.Calendar.Id" asp-route-date="@(new DateTime(Model.CurrentYear, Model.CurrentMonth, 1))" class="btn btn-outline-primary">
                <i class="fa fa-file-csv"></i> CSV
            </a>
            <a asp-action="ExportToIcs" asp-route-calendarId="@Model.Calendar.Id" asp-route-date="@(new DateTime(Model.CurrentYear, Model.CurrentMonth, 1))" class="btn btn-outline-secondary">
                <i class="fa fa-calendar"></i> ICS
            </a>
        </div>

        <!-- Export Year with Dropdown -->
        <div>
            <h5>Export Year</h5>
            <form asp-action="ExportYear" method="get">
                <div class="d-flex gap-2">
                    <select name="SelectedCountry" class="form-select w-auto">
                        @foreach (var country in Model.AvailableCountries)
                        {
                            <option value="@country.Value" selected="@(country.Value == Model.SelectedCountry)">@country.Text</option>
                        }
                    </select>
                    <select name="year" class="form-select w-auto">
                        @for (int year = DateTime.Now.Year - 5; year <= DateTime.Now.Year + 5; year++)
                        {
                            <option value="@year" selected="@(year == Model.CurrentYear)">@year</option>
                        }
                    </select>
                    <button type="submit" name="format" value="excel" class="btn btn-outline-success">
                        <i class="fa fa-file-excel"></i> Excel
                    </button>
                    <button type="submit" name="format" value="pdf" class="btn btn-outline-danger">
                        <i class="fa fa-file-pdf"></i> PDF
                    </button>
                    <button type="submit" name="format" value="csv" class="btn btn-outline-primary">
                        <i class="fa fa-file-csv"></i> CSV
                    </button>
                    <button type="submit" name="format" value="ics" class="btn btn-outline-secondary">
                        <i class="fa fa-calendar"></i> ICS
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
