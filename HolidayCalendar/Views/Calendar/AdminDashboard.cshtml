@model IEnumerable<CalendarDto>

<div class="container py-5">
    <h1>Admin Dashboard</h1>

    <table class="table table-bordered table-striped mt-4">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Country</th>
                <th>Holidays</th>
                <th>Default</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var calendar in Model)
            {
                <tr>
                    <td>@calendar.Calendar.Name</td>
                    <td>@calendar.Calendar.CountryCode</td>
                    <td>@(calendar.Holidays?.Count ?? 0)</td>
                    <td>@(calendar.Calendar.IsDefault ? "Yes" : "No")</td>
                    <td>
                        <a asp-action="Index" asp-route-id="@calendar.Calendar.Id" class="btn btn-primary btn-sm">View</a>
                        <a asp-action="Edit" asp-route-id="@calendar.Calendar.Id" class="btn btn-warning btn-sm mx-1">Edit</a>
                        <a asp-action="Delete" asp-route-id="@calendar.Calendar.Id" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
