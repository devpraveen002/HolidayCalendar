@model IEnumerable<CalendarSummaryViewModel>

<div class="container py-5">
    <h1>Admin Dashboard</h1>

    <div class="d-flex justify-content-end mb-4">
        <a asp-action="CreateCountryCalendar" class="btn btn-primary">Create Country Calendar</a>
    </div>

    <table class="table table-bordered table-striped mt-4">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Country</th>
                <th>Holidays</th>
                <th>Default</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var calendar in Model)
            {
                <tr>
                    <td>@calendar.Name</td>
                    <td>@calendar.CountryCode</td>
                    <td>@calendar.HolidayCount</td>
                    <td>@(calendar.IsDefault ? "Yes" : "No")</td>
                    <td>
                        <a asp-action="View" asp-route-id="@calendar.Id" class="btn btn-primary btn-sm">View</a>
                        <a asp-action="Edit" asp-route-id="@calendar.Id" class="btn btn-warning btn-sm mx-1">Edit</a>
                        <form asp-action="Delete" asp-route-id="@calendar.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
